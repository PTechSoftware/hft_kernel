{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run kernel in QEMU",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/bin/qemu-system-x86_64",
      "args": [
        "-drive",
        "format=raw,file=${workspaceFolder}/target/x86_64-hft/debug/bootimage-hft_ptechos.bin"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "console": "externalTerminal",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
