{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build bootimage",
      "type": "shell",
      "command": "cargo bootimage --target x86_64-hft.json",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run kernel in QEMU",
      "type": "shell",
      "command": "cargo run",
      "options": {
        "env": {
          "PATH": "${env:PATH};C:\\Program Files\\qemu"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Setup Windows Environment",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/windows_precompile.ps1\"",
      "problemMatcher": []
    }
  ]
}
